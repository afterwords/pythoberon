# Network - LAN
SUBNET="192.168.42.0/24"
PROVISIONING_SERVER_IP="192.168.42.100"
NODE1_IP="192.168.42.101"
NODE2_IP="192.168.42.102"
NODE1_HOSTNAME="pythoberon1"
NODE2_HOSTNAME="pythoberon2"
# Node B (RPC worker): give it extra GPU memory (GTT) — 12.5 GiB = 3276800 × 4 KiB pages
NODE2_GTT_PAGES_LIMIT="3276800"
NODE1_MAC="A8:A1:59:B4:00:00"
NODE2_MAC="A8:A1:59:B4:00:01"

# Network - Dedicated 2.5GbE Direct Cluster Interconnect (between Node 1 and Node 2)
# setup-llama-server.sh assigns these /30 addresses to the single detected USB Ethernet interface.
NODE1_DIRECT_IP="10.0.42.1"
NODE2_DIRECT_IP="10.0.42.2"
RPC_PORT="50052"

# Provisioning Server
PROVISIONING_USER="admin"

# Llama.cpp Distributed Cluster
LLAMA_SERVER_USER="llama"
LLAMA_SERVER_PORT="8080"
LLAMA_API_KEY="" #Optional: Set to a secure value for production use. If left empty, no API key will be required.
LLAMA_PARALLEL="1"
LLAMA_CACHE_K="q8_0"
LLAMA_CACHE_V="q8_0"
LLAMA_FLASH_ATTN="on"
MODEL_DIR="/home/llama/models"
MODELS_CONFIG="/home/llama/models.ini"
DEFAULT_MODEL="Qwen3.6-35B"
DEFAULT_MODEL_HF="unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q4_K_M"
DEFAULT_MODEL_CTX_SIZE="98304"
DEFAULT_MODEL_TENSOR_SPLIT="46,54"
DEFAULT_MODEL_REASONING="on"
DEFAULT_MODEL_REASONING_BUDGET="4096"
DEFAULT_MODEL_REPEAT_PENALTY="1.05"

# Open WebUI
OPENWEBUI_PORT="3000"
ENABLE_WEB_SEARCH=true
MODELS_PUBLIC=true

# SearXNG
SEARXNG_PORT="8088"
